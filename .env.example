# Copy to .env.local for local development. Never commit real keys.

# Website (Vercel) — read-only access
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: password-protect the whole site while testing
SITE_PASSWORD=choose-a-password

# Collectors (GitHub Actions secrets) — write access
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GSA_API_KEY=your-api-data-gov-key
